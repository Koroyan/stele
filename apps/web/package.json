{
  "name": "@stele/web",
  "version": "1.0.0",
  "private": true,
  "description": "Stele web application: marketing site, dashboard, hosted acceptance, receipts and the in-browser verifier",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-embed.mjs && next dev --port 3000",
    "build": "node scripts/sync-embed.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@stelehq/protocol": "workspace:*",
    "@stelehq/sdk": "workspace:*",
    "@stele/ui": "workspace:*",
    "@stelehq/verifier": "workspace:*",
    "diff": "^9.0.0",
    "geist": "^1.7.2",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
