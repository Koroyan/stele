# ------------------------------------------------------------------------------------------------
# Stele environment template. Copy to `.env` (git-ignored) and fill in values.
# NEVER commit real secrets, keypairs or seed phrases. For localnet, `pnpm localnet:env` writes a
# ready-to-use `.env` with freshly generated secrets.
# ------------------------------------------------------------------------------------------------

# ---- API (apps/api) -------------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (used for client IP / rate limiting).
TRUST_PROXY_HOPS=0

# PostgreSQL connection string. TLS is required unless the host is localhost.
# Local development without PostgreSQL: DATABASE_URL=pglite:../../.data/pglite (single process).
DATABASE_URL=postgres://stele:stele@localhost:5432/stele
# Apply database migrations when the process starts (otherwise run `pnpm db:migrate`).
MIGRATE_ON_START=false

# Public origin of the web app: cookies, CSRF Origin checks and the sign-in message domain.
APP_ORIGIN=http://localhost:3000
EXTRA_APP_ORIGINS=
# Host shown as "Requested by" for Stele-hosted acceptance pages.
HOSTED_ACCEPT_DOMAIN=localhost

# mainnet | devnet | localnet (localnet: this machine only, refused in production)
SOLANA_CLUSTER=localnet
# RPC endpoints used by the server (may contain provider API keys — never sent to browsers).
SOLANA_RPC_URLS=http://127.0.0.1:8899
# RPC endpoints advertised to browsers for independent verification (no secrets!).
PUBLIC_RPC_URLS=http://127.0.0.1:8899
PROGRAM_ID=6sTKscWmUtBQRMpNCiEpurCJxpjx7GK5rzk7e265kpwV

# Hot keys with deliberately minimal power (file path, JSON byte array, or base58 secret key).
# The relayer only pays fees for acceptances; the attestor only vouches for DNS-verified domains.
# Production: load from a secrets manager / mounted secret file, never from this file.
RELAYER_KEYPAIR=../../.data/localnet/relayer.json
ATTESTOR_KEYPAIR=../../.data/localnet/attestor.json
PRIORITY_FEE_MICROLAMPORTS=0

# ---- Billing ----
# Recordings (acceptances + proofs) each organization may make per month for free.
STELE_FREE_RECORDS_PER_MONTH=1000
# On-chain passkey enrollments (account mode) funded per organization per month (rent ~0.0025 SOL each)
STELE_MAX_ENROLLMENTS_PER_MONTH=500
# Where credit purchases are paid: a plain address (the API never holds its key). Empty = no sales.
STELE_TREASURY_ADDRESS=
# Credit packs on sale, as credits:SOL pairs.
STELE_CREDIT_PACKS=10000:0.5,100000:4,1000000:30

# 32 random bytes, base64 — encrypts webhook signing secrets at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# At least 16 random characters — keyed hash for IP addresses in rate limits and sessions.
IP_HASH_SECRET=
# Internal PDF renderer (apps/pdf-renderer) for PDF receipts. Docker Compose sets it; unset = disabled.
# Locally: `pnpm dev:pdf` (uses an installed Chrome or Edge) and uncomment:
# PDF_RENDERER_URL=http://127.0.0.1:4100

# Content storage for canonical document bytes (content-addressed by SHA-256).
STORAGE_PROVIDER=filesystem
STORAGE_DIR=../../.data/storage
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PREFIX=content/

# Public mirror advertised to verifiers: `${PUBLIC_CONTENT_BASE_URL}/${sha256}`.
PUBLIC_CONTENT_BASE_URL=http://localhost:4000/v1/public/content

# Optional Redis for distributed rate limiting (multiple API instances).
# REDIS_URL=redis://localhost:6379

# DNS-over-HTTPS resolvers that must ALL see the TXT record for domain verification.
DOH_RESOLVERS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve

SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12
# Minutes after a wallet signature during which sensitive actions are allowed.
STEP_UP_MINUTES=10
# Run webhook / finality / expiry workers inside the API process.
RUN_WORKERS=true
# Run the chain indexer in the API process (needed with the embedded PGlite database).
RUN_INDEXER=false

# ---- Public live demo (/demo) — devnet and localnet only; the API refuses these on mainnet -------

# The demo organization and its owner key. The owner publishes a fresh document (and, for the Gate
# demo, a policy and a demo vault) per visitor session. A dedicated throwaway key — never a customer
# or operator key. Unset = the live demo is off. Localnet: `pnpm --filter @stele/localnet live-demo`.
# STELE_DEMO_OWNER_KEYPAIR=../../.data/localnet/live-demo-owner.json
# STELE_DEMO_ORGANIZATION=
# Sessions per day (all visitors together) and per IP address.
STELE_DEMO_DAILY_SESSIONS=60
STELE_DEMO_SESSIONS_PER_IP=6

# ---- Web app (apps/web) ---------------------------------------------------------------------------

# Where the Next.js server reaches the API (rewrites /api/* → this URL).
API_INTERNAL_URL=http://127.0.0.1:4000
# Values pinned into the browser bundle and compared with what the API advertises.
NEXT_PUBLIC_PROGRAM_ID=6sTKscWmUtBQRMpNCiEpurCJxpjx7GK5rzk7e265kpwV
# NEXT_PUBLIC_CHAIN_ID=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# Comma-separated RPC endpoints the browser reads from (empty = use PUBLIC_RPC_URLS from the API).
NEXT_PUBLIC_RPC_URLS=
# Optional link to the source repository shown in the footer and docs.
# NEXT_PUBLIC_REPO_URL=
# Network switcher. Stele offers Devnet (testing) and Mainnet (production); each is a separate
# deployment (its own API, database, keys and address). List them as cluster=url, in display
# order; an entry without a URL is shown as "not available". The current network always comes
# from the API.
# STELE_NETWORKS=mainnet=https://app.stele.example,devnet=https://devnet.app.stele.example
