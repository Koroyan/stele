{
  "name": "@stelehq/sdk",
  "version": "1.3.0",
  "description": "Stele SDK — verified agreement acceptance for browsers, React components and server helpers",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./server": "./src/server.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/index.ts src/react.tsx src/server.ts --format esm --dts --clean --sourcemap --external react && pnpm run build:embed",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "build:embed": "tsup --config tsup.embed.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "@stelehq/protocol": "workspace:*",
    "@stelehq/verifier": "workspace:*",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@types/react": "^19.2.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
