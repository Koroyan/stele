{
  "name": "@stele/db",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations and client for the Stele index (never evidence)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
