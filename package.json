{
  "name": "stele",
  "private": true,
  "description": "Stele — verifiable agreement infrastructure on Solana",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @stele/api run dev",
    "dev:web": "pnpm --filter @stele/web run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vectors": "pnpm --filter @stele/protocol run vectors",
    "db:generate": "pnpm --filter @stele/db run generate",
    "db:migrate": "pnpm --filter @stele/db run migrate",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "localnet:keys": "pnpm --filter @stele/localnet run keys",
    "localnet:env": "pnpm --filter @stele/localnet run env",
    "localnet:seed": "pnpm --filter @stele/localnet run seed",
    "test:e2e": "pnpm --filter @stele/e2e run test:e2e",
    "localnet:attest-domain": "pnpm --filter @stele/localnet run attest-domain",
    "localnet:demo": "pnpm --filter @stele/localnet run demo",
    "demo:shop": "pnpm --filter @stele/demo-shop run start",
    "localnet:costs": "pnpm --filter @stele/localnet run costs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.11.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
